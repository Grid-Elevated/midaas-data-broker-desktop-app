{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIDAAS Data Broker",
  "version": "0.2.25",
  "identifier": "com.midaas.databroker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MIDAAS Data Broker",
        "width": 960,
        "height": 700,
        "visible": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Grid-Elevated/midaas-data-broker-desktop-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQkJEREZFNjZDQ0FBOTcKUldTWHFzeG0vdDI3bW9vbE5zUWJNMm9vOW15a3IvbktCUkQ4dnlsQTNCbExrU2laQ0tyRU5kMXkK"
    }
  }
}
